# ------------------------------------------------------------------
# Green Valley SRMS - environment configuration (EXAMPLE)
#
# Copy this file to ".env" in the same folder and fill in real values:
#     cp .env.example .env
#
# NEVER commit the real .env file and NEVER put these values in HTML/JS.
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=green_valley
DB_USER=mole
DB_PASS=your_password_here

# Optional: application settings
APP_ENV=development     # development | production  (production hides raw errors)

# Optional: student sign-in address printed on portal login slips. Leave unset
# to use the address the admin opened the Student Portal page with.
# PORTAL_URL=https://records.greenvalley.sc.ke/login.php

# Optional: SMTP email for password reset links. Uncomment and fill in to enable
# email sending from the "Forgot password?" flow.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=your_email@gmail.com
