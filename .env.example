# ------------------------------------------------------------------
# Green Valley SRMS - environment configuration (EXAMPLE)
#
# Copy this file to ".env" in the same folder and fill in real values:
#     cp .env.example .env
#
# NEVER commit the real .env file and NEVER put these values in HTML/JS.
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=green_valley
DB_USER=mole
DB_PASS=your_password_here

# Optional: application settings
APP_ENV=development     # development | production  (production hides raw errors)

# Base URL for the application (used in password reset emails, etc.)
# For local development: http://localhost
# For production: https://records.greenvalley.sc.ke
APP_BASE_URL=http://localhost

# Optional: student sign-in address printed on portal login slips. Leave unset
# to use the address the admin opened the Student Portal page with.
# PORTAL_URL=https://records.greenvalley.sc.ke/login.php

# SMTP email for password reset links. Fill in to enable email sending from
# the "Forgot password?" flow.
#
# For Gmail, you must use an App Password (not your regular password):
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Generate an App Password: https://myaccount.google.com/apppasswords
#   3. Use the 16-character code (without spaces) as SMTP_PASS
#
# For other providers, contact your IT department for SMTP settings.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_FROM_NAME=Green Valley SRMS
