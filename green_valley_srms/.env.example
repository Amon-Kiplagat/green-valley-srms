# ------------------------------------------------------------------
# Green Valley SRMS - environment configuration (EXAMPLE)
#
# Copy this file to ".env" in the same folder and fill in real values:
#     cp .env.example .env
#
# NEVER commit the real .env file and NEVER put these values in HTML/JS.
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=green_valley
DB_USER=mole
DB_PASS=your_password_here

# Optional: application settings
APP_ENV=development     # development | production  (production hides raw errors)
